# ============================================================
# Ghostwriter — автопостинг в Threads
# Скопируй в .env и заполни значения
# ============================================================

# ---------- Telegram ----------
# Токен у @BotFather
TELEGRAM_BOT_TOKEN=
# Свой ID через запятую (узнать: /start у бота покажет ID, или @userinfobot)
TELEGRAM_ADMIN_IDS=

# ---------- Threads / Meta ----------
# App Dashboard → Use cases → Threads API → Settings
THREADS_APP_ID=
THREADS_APP_SECRET=
# Должен символ в символ совпадать с "Valid OAuth redirect URIs" в приложении Meta
THREADS_REDIRECT_URI=https://your-domain.com/auth/threads/callback
# Если токен уже есть — можно вставить здесь (иначе он появится после OAuth)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# true — не публиковать реально (для проверки генерации)
THREADS_DRY_RUN=false

# ---------- LLM (OpenAI-совместимый провайдер) ----------
# openai      — OpenAI, DeepSeek, OpenRouter, Ollama, vLLM и т.п.
# anthropic   — нативный Claude API
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
WRITER_MODEL=deepseek-chat

# Пример для OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# WRITER_MODEL=gpt-4o-mini
#
# Пример для Claude (нативно):
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# WRITER_MODEL=claude-sonnet-5-5
#
# Пример для OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# WRITER_MODEL=anthropic/claude-sonnet-5-5

# ---------- Бренд ----------
BRAND_NICHE=технологии, продуктивность и искусственный интеллект
BRAND_VOICE=живой и дружелюбный тон, без канцелярита; короткие абзацы; конкретика вместо общих слов
BRAND_AUDIENCE=предприниматели, разработчики и авторы проектов 25–40 лет
BRAND_LANGUAGE=ru
BRAND_CTA=
FORBIDDEN_TOPICS=
MAX_POST_CHARS=500

# ---------- Постоянный медиасток ----------
# JPEG/PNG, до 8 МБ; загрузка простой отправкой изображения Telegram-боту
STOCK_MEDIA_DIR=data/stock
STOCK_IMAGES_ENABLED=true

# ---------- Режим публикации ----------
# false — каждый пост сначала приходит в Telegram на подтверждение
AUTO_APPROVE=false
POSTING_TIMES=09:00,13:00,19:00
# Реальный запуск каждого слота будет случайным в диапазоне ±N минут
POSTING_JITTER_MINUTES=10
# Окно для команды /frequency
POSTING_WINDOW_START=09:00
POSTING_WINDOW_END=19:00
TIMEZONE=Europe/Moscow
MAX_POSTS_PER_DAY=10
MIN_MINUTES_BETWEEN_POSTS=60

# ---------- Web / OAuth ----------
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Публичный адрес сервера (для ссылки авторизации и data-deletion)
PUBLIC_BASE_URL=https://your-domain.com
# Ключ к /auth/threads?key=... — обязательно задай в проде
WEB_AUTH_KEY=

# ---------- Прочее ----------
DB_PATH=data/ghostwriter.db
LOG_LEVEL=INFO
